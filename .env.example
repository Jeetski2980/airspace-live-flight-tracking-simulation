# Cesium ion public-client token. Set this in .env.local; restrict allowed URLs/assets/scopes in ion.
VITE_CESIUM_ION_TOKEN=your_cesium_ion_public_client_token

# Optional Groq API key. Server only; never add a VITE_ prefix.
GROQ_API_KEY=your_groq_api_key
# Optional model override. Defaults to Groq's GPT-OSS 20B JSON Schema model.
GROQ_MODEL=openai/gpt-oss-20b

# Cesium ion public-client token. Set this in .env.local; restrict allowed URLs/assets/scopes in ion.
VITE_CESIUM_ION_TOKEN=your_cesium_ion_public_client_token

# OpenSky OAuth2 client credentials. Server only; never add VITE_ to these names.
OPENSKY_CLIENT_ID=your_opensky_client_id
OPENSKY_CLIENT_SECRET=your_opensky_client_secret

# Optional AI assistant. Server only. GPT-5 mini is the default model.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini
